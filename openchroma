    def toggle_key_selection(self, key_name):
        if key_name in self.selected_keys:
            self.selected_keys.remove(key_name)
        else:
            self.selected_keys.add(key_name)
        self.update_key_styles()

    def start_drag_paint(self, key_name):
        self.is_dragging = True
        self.paint_key(key_name)

    def mouseReleaseEvent(self, event):
        if event.button() == Qt.MouseButton.LeftButton:
            self.is_dragging = False
        super().mouseReleaseEvent(event)

    def paint_key(self, key_name):
        rgb = [self.current_color.red(), self.current_color.green(), self.current_color.blue()]
        self.color_buffer[key_name] = rgb
        self.update_key_styles()
        self.flush_frame()

    def update_key_styles(self):
        for name, btn in self.key_buttons.items():
            is_selected = name in self.selected_keys
            col = self.color_buffer.get(name)
            
            if col:
                bg_str = f"rgb({col[0]}, {col[1]}, {col[2]})"
                luminance = (col[0] * 0.299 + col[1] * 0.587 + col[2] * 0.114)
                txt_col = "#000000" if luminance > 120 else "#ffffff"
            else:
                bg_str = "#2b2b2b"
                txt_col = "#dcdcdc"

            border = "2px solid #ffffff" if is_selected else "1px solid #3c3c3c"
            btn.setStyleSheet(
                f"background-color: {bg_str}; "
                f"border: {border}; "
                f"border-radius: 4px; "
                f"color: {txt_col}; "
                f"font-size: 10px; "
                f"font-weight: bold; "
                f"padding: 1px;"
            )

    def apply_color_to_selected(self):
        rgb = [self.current_color.red(), self.current_color.green(), self.current_color.blue()]
        for k in self.selected_keys:
            self.color_buffer[k] = rgb
        self.update_key_styles()
        self.flush_frame()

    def deselect_all_keys(self):
        self.selected_keys.clear()
        self.update_key_styles()

    def clear_selected_keys(self):
        for k in self.selected_keys:
            if k in self.color_buffer:
                del self.color_buffer[k]
        self.update_key_styles()
        self.flush_frame()

    def clear_all_keys(self):
        self.color_buffer.clear()
        self.selected_keys.clear()
        self.update_key_styles()
        self.flush_frame()

    def on_color_picked(self, col: QColor):
        self.current_color = col
        hex_str = col.name()
        self.color_indicator.setStyleSheet(f"background-color: {hex_str}; border: none; border-radius: 3px;")

    def paint_zone_group(self, zone_type):
        f_keys = {"Esc", "F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10", "F11", "F12"}
        qwerty_keys = {"`", "1", "2", "3", "4", "5", "6", "7", "8", "9", "0", "-", "=", "Backspace", 
                       "Tab", "Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P", "[", "]", "\\", 
                       "Caps", "A", "S", "D", "F", "G", "H", "J", "K", "L", ";", "'", "Enter", 
                       "Shift", "Z", "X", "C", "V", "B", "N", "M", ",", ".", "/", "RShift",
                       "Ctrl", "Win", "Alt", "Space", "RAlt", "Fn", "Menu", "RCtrl"}
        control_keys = {"PrtSc", "ScrollLock", "Pause", "Ins", "Home", "PgUp", "Del", "End", "PgDn", "↑", "←", "↓", "→"}
        numpad_keys = {"NumLock", "Num_/", "Num_*", "Num_-", "Num_+", 
                       "Num_7", "Num_8", "Num_9", "Num_4", "Num_5", "Num_6", 
                       "Num_1", "Num_2", "Num_3", "Num_Enter", "Num_0", "Num_."}

        target_set = {
            "f_keys": f_keys,
            "qwerty": qwerty_keys,
            "control": control_keys,
            "numpad": numpad_keys
        }.get(zone_type, set())

        rgb = [self.current_color.red(), self.current_color.green(), self.current_color.blue()]
        for name in self.key_buttons.keys():
            if name in target_set:
                self.color_buffer[name] = rgb
                self.selected_keys.add(name)

        self.update_key_styles()
        self.flush_frame()

    def flush_frame(self):
        try:
            try:
                self.razer.set_matrix_effect_custom(self.target)
            except Exception as e:
                logger.error(f"Failed to set custom matrix effect: {e}")

            matrix = [[(0, 0, 0) for _ in range(22)] for _ in range(6)]
            
            for key_name, rgb in self.color_buffer.items():
                if key_name in self.coords:
                    info = self.coords[key_name]
                    r_idx = info[0]
                    c_start = info[1]
                    c_end = info[2]
                    r_end = info[3] if len(info) > 3 else r_idx
                    color_tuple = (int(rgb[0]), int(rgb[1]), int(rgb[2]))
                    for r in range(r_idx, r_end + 1):
                        for c in range(c_start, c_end + 1):
                            if 0 <= r < 6 and 0 <= c < 22:
                                matrix[r][c] = color_tuple

            matrix_tuples = [tuple(row) for row in matrix]
            self.razer.set_matrix_custom_frame(self.target, matrix_tuples)
        except Exception as e:
            logger.error(f"Keyboard custom frame flush error: {e}")

    def save_and_close(self):
        main_app = self.parent() or self.window()
        
        target_profile = "Default Profile"
        if main_app and hasattr(main_app, 'get_active_profile_name'):
            target_profile = main_app.get_active_profile_name()
            
        if main_app and hasattr(main_app, 'profiles') and target_profile in main_app.profiles:
            if "matrix" not in main_app.profiles[target_profile]:
                main_app.profiles[target_profile]["matrix"] = {}
            
            # Condense buffer, keeping only non-default colors
            condensed_buffer = {k: rgb for k, rgb in self.color_buffer.items() if rgb != [0, 255, 0]}
            
            # Explicitly assign the buffer (will be {} if cleared, wiping the JSON entry)
            main_app.profiles[target_profile]["matrix"]["keyboard"] = condensed_buffer
            
            if hasattr(main_app, 'save_profiles'):
                main_app.save_profiles()
            elif hasattr(main_app, 'save_config'):
                main_app.save_config()
            else:
                main_app.save_to_disk()

        QMessageBox.information(self, "Success", f"Keyboard layout saved successfully to '{target_profile}'!")
        self.accept()

