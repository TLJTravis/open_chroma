def get_asset_path(filename):
    base, ext = os.path.splitext(filename)
    extensions = [ext, ".png", ".jpg", ".jpeg", ".webp"]
    extensions = list(dict.fromkeys(extensions))
    
    for ext_candidate in extensions:
        candidate_name = base + ext_candidate
        paths = [
            os.path.join(os.path.dirname(os.path.abspath(__file__)), "assets", candidate_name),
            os.path.join("/usr/share/openchroma/assets", candidate_name)
        ]
        for p in paths:
            if os.path.exists(p):
                return p
    return os.path.join(os.path.dirname(os.path.abspath(__file__)), "assets", filename)

def get_cached_device_image(device_name, image_url, fallback="OpenChroma"):
    cache_dir = os.path.expanduser("~/.cache/openchroma/images")
    os.makedirs(cache_dir, exist_ok=True)
    
    if not device_name:
        device_name = "unknown_device"
        
    safe_name = str(device_name).lower().replace(" ", "_") + ".png"
    local_path = os.path.join(cache_dir, safe_name)
    
    if os.path.exists(local_path) and os.path.getsize(local_path) < 100:
        os.remove(local_path)
    
    if not os.path.exists(local_path) and image_url:
        try:
            urllib.request.urlretrieve(image_url, local_path)
            if os.path.exists(local_path) and os.path.getsize(local_path) < 100:
                os.remove(local_path)
        except Exception as e:
            logger.debug(f"Failed to download device image: {e}")
            if os.path.exists(local_path):
                os.remove(local_path)
            
    if not os.path.exists(local_path):
        fallback_path = get_asset_path(f"{fallback}.png")
        if os.path.exists(fallback_path):
            return fallback_path
            
    return local_path if os.path.exists(local_path) else None

