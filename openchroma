    def select_zone(self, index):
        self.selected_zone = index
        for hl in self.highlight_overlays.values():
            hl.hide()
        for idx, btn in self.zone_buttons.items():
            rgb = self.color_buffer[idx]
            color_str = f"rgb({rgb[0]}, {rgb[1]}, {rgb[2]})"
            border = "2px solid #00ff00" if idx == index else "1px solid #444444"
            btn.setStyleSheet(f"background-color: {color_str}; border: {border}; border-radius: 4px; color: #000000; font-weight: bold; font-size: 11px;")

        if index in self.highlight_overlays:
            self.highlight_overlays[index].show()

    def on_local_color_picked(self, col: QColor):
        self.current_color = col
        hex_str = col.name()
        self.local_hex.blockSignals(True)
        self.local_hex.setText(hex_str)
        self.local_hex.blockSignals(False)
        self.local_preview.setStyleSheet(f"background-color: {hex_str}; border: 1px solid #555555; border-radius: 4px;")

    def apply_local_hex(self):
        text = self.local_hex.text().strip()
        if not text.startswith("#"):
            text = "#" + text
        col = QColor(text)
        if col.isValid():
            self.current_color = col
            hex_str = col.name()
            self.local_preview.setStyleSheet(f"background-color: {hex_str}; border: 1px solid #555555; border-radius: 4px;")
            
            # Apply color to the currently selected zone
            rgb = [col.red(), col.green(), col.blue()]
            self.color_buffer[self.selected_zone] = rgb
            self.select_zone(self.selected_zone)
            self.flush_frame()
        else:
            QMessageBox.warning(self, "Invalid Hex", f"Could not parse '{text}' as a valid hex color code.")

    def set_brush_color(self, color: QColor):
        self.current_color = color
        self.on_local_color_picked(color)

    def load_frame(self, buffer):
        if isinstance(buffer, list) and len(buffer) == 3:
            self.color_buffer = buffer
        self.select_zone(self.selected_zone)

    def flush_frame(self):
        try:
            if not self.rgb_client:
                from openrgb import OpenRGBClient
                class SafeOpenRGBClient(OpenRGBClient):
                    def update(self):
                        try:
                            super().update()
                        except StopIteration:
                            pass
                self.rgb_client = SafeOpenRGBClient('127.0.0.1', 6742)

            if self.rgb_client:
                if not self.rgb_mouse:
                    for d in self.rgb_client.devices:
                        if 'Naga' in d.name:
                            self.rgb_mouse = d
                            break

                if self.rgb_mouse:
                    from openrgb.utils import RGBColor
                    for idx, rgb in enumerate(self.color_buffer):
                        if idx < len(self.rgb_mouse.zones):
                            color_obj = RGBColor(int(rgb[0]), int(rgb[1]), int(rgb[2]))
                            for led in self.rgb_mouse.zones[idx].leds:
                                led.set_color(color_obj)
                    self.rgb_mouse.show()
        except Exception as e:
            logger.debug(f"OpenRGB zone flush handled: {e}")

class PaintableKeyButton(QPushButton):
    def __init__(self, key_name, editor_dialog, parent=None):
        super().__init__(key_name, parent)
        self.key_name = key_name
        self.editor = editor_dialog
        self.setCheckable(False)  # Disable native checkable behavior to stop hover toggles
        self.setMouseTracking(False)

    def mousePressEvent(self, event):
        if self.editor and event.button() == Qt.MouseButton.LeftButton:
            self.editor.is_dragging = True
            # Toggle or add to selection
            self.editor.toggle_key_selection(self.key_name)
            event.accept()
        else:
            super().mousePressEvent(event)

    def mouseMoveEvent(self, event):
        # Only select/paint while dragging with left mouse button held down
        if self.editor and getattr(self.editor, 'is_dragging', False):
            if event.buttons() & Qt.MouseButton.LeftButton:
                if self.key_name not in self.editor.selected_keys:
                    self.editor.selected_keys.add(self.key_name)
                    self.editor.update_key_styles()
                event.accept()
                return
        super().mouseMoveEvent(event)

    def enterEvent(self, event):
        super().enterEvent(event)
        if self.editor and getattr(self.editor, 'is_dragging', False):
            self.editor.start_drag_paint(self.key_name)

